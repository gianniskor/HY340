Grammar

    0 $accept: program $end

    1 program: stmts
    2        | /* empty */

    3 stmts: stmt
    4      | stmts stmt

    5 stmt: expression ";"
    6     | ifstmt
    7     | whilestmt
    8     | forstmt
    9     | returnstmt
   10     | "break" ";"
   11     | "continue" ";"
   12     | block
   13     | funcdef
   14     | ";"

   15 expression: assignexpr
   16           | term
   17           | expression "+" expression
   18           | expression "-" expression
   19           | expression "*" expression
   20           | expression "/" expression
   21           | expression "%" expression
   22           | expression "==" expression
   23           | expression "!=" expression
   24           | expression "<" expression
   25           | expression ">" expression
   26           | expression "<=" expression
   27           | expression ">=" expression
   28           | expression "and" expression
   29           | expression "or" expression

   30 term: "(" expression ")"
   31     | "-" expression
   32     | "not" expression
   33     | "++" lvalue
   34     | lvalue "++"
   35     | "--" lvalue
   36     | lvalue "--"
   37     | primary

   38 assignexpr: lvalue "=" expression

   39 primary: lvalue
   40        | call
   41        | objectdef
   42        | "(" funcdef ")"
   43        | const

   44 lvalue: ID
   45       | "local" ID
   46       | "::" ID
   47       | member

   48 member: lvalue "." ID
   49       | lvalue "[" expression "]"
   50       | call "." ID
   51       | call "[" expression "]"

   52 call: call "(" elist ")"
   53     | lvalue callsuffix
   54     | "(" funcdef ")" "(" elist ")"

   55 callsuffix: normcall
   56           | methodcall

   57 normcall: "(" elist ")"

   58 methodcall: ".." ID "(" elist ")"

   59 elist: expression
   60      | elist "," expression

   61 objectdef: "[" elist "]"
   62          | "[" indexed "]"
   63          | "[" "]"

   64 indexed: indexedelem
   65        | indexedelem "," indexedelem

   66 indexedelem: "{" expression ":" expression "}"

   67 openblock: "{" stmt
   68          | openblock stmt

   69 @1: /* empty */

   70 @2: /* empty */

   71 block: "{" @1 "}" @2

   72 @3: /* empty */

   73 block: openblock "]" @3

   74 funcdef: "function" ID "(" idlist ")" block
   75        | "function" "(" ")" block

   76 const: INT
   77      | REAL
   78      | STRING
   79      | "nil"
   80      | "true"
   81      | "false"

   82 idlist: ID
   83       | idlist "," ID

   84 ifstmt: "if" "(" expression ")" stmt
   85       | "if" "(" expression ")" stmt "else" stmt

   86 whilestmt: "while" "(" expression ")" stmt

   87 forstmt: "for" "(" elist ";" expression ";" elist ")" stmt

   88 returnstmt: "return" expression ";"
   89           | "return" ";"


