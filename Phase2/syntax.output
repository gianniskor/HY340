Grammar

    0 $accept: program $end

    1 program: stmts
    2        | ε

    3 stmts: stmt
    4      | stmts stmt

    5 stmt: expression ";"
    6     | ifstmt
    7     | whilestmt
    8     | forstmt
    9     | returnstmt
   10     | "break" ";"
   11     | "continue" ";"
   12     | block
   13     | funcdef
   14     | ";"
   15     | ε

   16 expression: assignexpr
   17           | term
   18           | expression "+" expression
   19           | expression "-" expression
   20           | expression "*" expression
   21           | expression "/" expression
   22           | expression "%" expression
   23           | expression "==" expression
   24           | expression "!=" expression
   25           | expression "<" expression
   26           | expression ">" expression
   27           | expression "<=" expression
   28           | expression ">=" expression
   29           | expression "and" expression
   30           | expression "or" expression

   31 term: "(" expression ")"
   32     | "-" expression
   33     | "not" expression
   34     | "++" lvalue
   35     | lvalue "++"
   36     | "--" lvalue
   37     | lvalue "--"
   38     | primary

   39 assignexpr: lvalue "=" expression

   40 primary: lvalue
   41        | call
   42        | objectdef
   43        | "(" funcdef ")"
   44        | const

   45 lvalue: ID
   46       | "local" ID
   47       | "::" ID
   48       | member

   49 member: lvalue "." ID
   50       | lvalue "[" expression "]"
   51       | call "." ID
   52       | call "[" expression "]"

   53 call: call "(" elist ")"
   54     | lvalue callsuffix
   55     | "(" funcdef ")" "(" elist ")"

   56 callsuffix: normcall
   57           | methodcall

   58 normcall: "(" elist ")"

   59 methodcall: ".." ID "(" elist ")"

   60 elist: ε
   61      | elist "," expression
   62      | expression

   63 objectdef: "[" elist "]"
   64          | "[" indexed "]"

   65 indexed: indexedelem
   66        | indexed "," indexedelem

   67 indexedelem: "{" expression ":" expression "}"

   68 $@1: ε

   69 block: "{" $@1 stmts "}"
   70      | "{" "}"

   71 funcprefix: "function" ID "("

   72 $@2: ε

   73 funcdef: funcprefix idlist ")" $@2 block

   74 $@3: ε

   75 $@4: ε

   76 funcdef: "function" "(" $@3 idlist ")" $@4 block

   77 const: INT
   78      | REAL
   79      | STRING
   80      | "nil"
   81      | TRUE
   82      | FALSE

   83 idlist: ε
   84       | ID
   85       | idlist "," ID

   86 ifprefix: "if" "(" expression ")"

   87 elseprefix: "else"

   88 ifstmt: ifprefix stmt elseprefix stmt
   89       | ifprefix stmt

   90 whileflag: "(" expression ")"

   91 startwhile: "while"

   92 $@5: ε

   93 $@6: ε

   94 loop: $@5 stmt $@6

   95 whilestmt: startwhile whileflag loop

   96 N: ε

   97 M: ε

   98 forprefix: "for" "(" elist ";" M expression ";"

   99 forstmt: forprefix N elist ")" N loop N

  100 returnstmt: "return" expression ";"
  101           | "return" ";"


